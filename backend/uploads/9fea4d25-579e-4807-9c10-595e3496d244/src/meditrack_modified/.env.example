# ============================================================
# MediTrack - Sistema de Medicamentos Inteligente
# Copia este archivo como .env y configura tus valores
# ============================================================

# Flask
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=cambia-esto-por-una-clave-segura-aleatoria

# MongoDB
MONGO_URI=mongodb://localhost:27017/meditrack
MONGO_DB_NAME=meditrack

# JWT
JWT_SECRET_KEY=cambia-esto-por-otra-clave-segura
JWT_ACCESS_TOKEN_EXPIRES=3600       # segundos (1 hora)
JWT_REFRESH_TOKEN_EXPIRES=604800    # segundos (7 días)

# Correo (para notificaciones)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=tu_contraseña_de_aplicacion
MAIL_DEFAULT_SENDER=MediTrack <tu_correo@gmail.com>

# Paginación por defecto
DEFAULT_PAGE_SIZE=20

# IoT (preparado para implementación futura)
IOT_ENABLED=False
IOT_BROKER_HOST=localhost
IOT_BROKER_PORT=1883
IOT_BROKER_USER=
IOT_BROKER_PASSWORD=
IOT_TOPIC_PREFIX=meditrack/devices

# Notificaciones Push (FCM - futuro)
FCM_ENABLED=False
FCM_SERVER_KEY=

# Modo de prueba (desactiva envío real de emails)
TESTING=False
