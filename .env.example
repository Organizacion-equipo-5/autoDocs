# Renombra este archivo a .env y ajusta los valores

# SECRET_KEY=autodocs-super-secret-key-2025
# JWT_SECRET_KEY=jwt-autodocs-secret-key-2025
# MONGO_URI=mongodb://localhost:27017/autodocs_ai
# FLASK_DEBUG=True
# UPLOAD_FOLDER=./uploads
# EXPORT_FOLDER=./exports
# GITHUB_WEBHOOK_SECRET=usa-un-secreto-aleatorio-para-el-webhook

# GitHub OAuth (obligatorio para conectar la cuenta de GitHub)
# Crea una OAuth App en https://github.com/settings/developers
# El "Authorization callback URL" de la OAuth App debe ser EXACTAMENTE igual a GITHUB_REDIRECT_URI
# GITHUB_CLIENT_ID=tu_client_id
# GITHUB_CLIENT_SECRET=tu_client_secret
# En local:      http://localhost:5000/api/github/callback
# En producción: https://autodocs-s5jh.onrender.com/api/github/callback (valor por defecto)
# GITHUB_REDIRECT_URI=http://localhost:5000/api/github/callback
# GITHUB_OAUTH_SCOPE=read:user user:email repo

# API Key de Groq para IA (puedes agregar múltiples separadas por comas)
# Ejemplo: GROQ_API_KEY=key1,key2,key3
GROQ_API_KEY=API_KEY_GROQ

